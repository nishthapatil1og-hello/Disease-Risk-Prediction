    {
      "cell_type": "code",
      "source": [
        "import joblib\n",
        "\n",
        "# Save the trained pipeline and the exact training feature order\n",
        "model_bundle = {\n",
        "    \"model\": logistic_model,\n",
        "    \"features\": X.columns.tolist(),\n",
        "    \"target\": target\n",
        "}\n",
        "\n",
        "joblib.dump(model_bundle, \"logistic_model.pkl\")\n",
        "\n",
        "print(\"Model saved successfully!\")\n",
        "\n",
        "files.download(\"logistic_model.pkl\")"
