        "<a href=\"https://colab.research.google.com/github/nishthapatil1og-hello/Disease-Risk-Prediction/blob/main/dpe_m1.ipynb2\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
