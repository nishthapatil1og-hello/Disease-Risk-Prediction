            "\n",
            "Column names:\n",
            "['Patient_ID', 'Age', 'Gender', 'BMI', 'Blood_Pressure', 'Cholesterol', 'Glucose', 'Heart_Rate', 'Smoking', 'Alcohol', 'Physical_Activity', 'Family_History', 'Stress_Level', 'Sleep_Hours', 'Disease_Risk', 'Likely_Disease']\n"
